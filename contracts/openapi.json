{
  "openapi": "3.1.0",
  "info": {
    "title": "Maakrijk API",
    "description": "Server-authoritative game platform API.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness plus a database round trip.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "Profiles of the signed-in household, oldest first.",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Profile"
                  }
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "profiles"
        ],
        "summary": "New profile. Errors: `nickname_length`, `nickname_invalid`, `avatar_invalid`,\n`nickname_taken`, `profile_limit`, `invalid_body`.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/profiles/{id}": {
      "delete": {
        "tags": [
          "profiles"
        ],
        "summary": "Delete a profile and all of its data.",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "profiles"
        ],
        "summary": "Change nickname and/or avatar.",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/session": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Reuses a valid session, or creates a new household with a new session.\nNeeds `X-Maakrijk: 1` (web) or `X-Maakrijk-Client: native`; only the\nnative shell receives the token in the body.",
        "operationId": "ensure_session",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "tags": [
          "ops"
        ],
        "operationId": "version",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "Every error response. `code` is stable and drives the Dutch text in the client.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "NewProfile": {
        "type": "object",
        "required": [
          "nickname",
          "avatar"
        ],
        "properties": {
          "avatar": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "nickname",
          "avatar",
          "createdAt"
        ],
        "properties": {
          "avatar": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          }
        }
      },
      "ProfilePatch": {
        "type": "object",
        "properties": {
          "avatar": {
            "type": [
              "string",
              "null"
            ]
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "SessionInfo": {
        "type": "object",
        "required": [
          "householdId",
          "created"
        ],
        "properties": {
          "created": {
            "type": "boolean",
            "description": "True when this request created a new household."
          },
          "householdId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": [
              "string",
              "null"
            ],
            "description": "Only for a native shell that asked for it; web clients never see the token."
          }
        }
      },
      "VersionInfo": {
        "type": "object",
        "required": [
          "api",
          "gitCommit",
          "dirty",
          "buildTime",
          "contract",
          "database"
        ],
        "properties": {
          "api": {
            "type": "string"
          },
          "buildTime": {
            "type": "string"
          },
          "contract": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "database": {
            "type": "string",
            "description": "Database name only, never the connection URL."
          },
          "dirty": {
            "type": "boolean"
          },
          "gitCommit": {
            "type": "string"
          },
          "migration": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Latest applied migration version, if any."
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mk_session"
      }
    }
  }
}
