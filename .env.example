# Local development defaults. These are not secrets; never put real credentials here.
# Copy to .env (git-ignored).
DATABASE_URL=postgres://maakrijk:maakrijk_dev_only@127.0.0.1:5450/maakrijk_dev
# Used by the Rust integration tests and the Playwright run.
TEST_DATABASE_URL=postgres://maakrijk:maakrijk_dev_only@127.0.0.1:5450/maakrijk_test
BIND_ADDR=127.0.0.1:8800
# Folder with a static Nuxt build to serve. Optional in development (Nuxt dev proxies /api).
WEB_DIR=
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Extra origins (comma separated) allowed to call the API with a bearer token,
# e.g. a native app shell. Empty means same-origin only.
ALLOWED_ORIGINS=
RUST_LOG=info,maakrijk_api=debug
